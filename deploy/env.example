# Copy to ".env" next to compose.yaml and fill in. None of these is a secret.
# The release tags and image digests come from release.env in the server pack:
#   docker compose --env-file release.env --env-file .env up -d
MODELHUB_VERSION=
POSTGRES_IMAGE=

# The address people and the import program use (https only), and the single host name.
PUBLIC_URL=https://modelhub.example.org
# The realm address of the existing Keycloak, for example https://keycloak.example.org/realms/modelhub
KEYCLOAK_ISSUER=
# The existing Artifactory and the Hugging Face repository key made for this system.
ARTIFACTORY_URL=https://artifactory.example.org
ARTIFACTORY_REPO=hf-local
# The oldest import program this server accepts (leave 0.0.0 to accept any).
MIN_CLIENT_VERSION=0.0.0
